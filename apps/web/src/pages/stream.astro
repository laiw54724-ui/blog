---
import BaseLayout from '../layouts/BaseLayout.astro'
import PostFeedCard from '../components/PostFeedCard.astro'
import { getPostsPage, getProfile } from '../lib/data'
import { buildEntryCardModels } from '../lib/presenters'
import { applyPageCacheHeaders } from '../lib/response'

const searchParams = Astro.url.searchParams
const page = Math.max(Number.parseInt(searchParams.get('page') || '1', 10) || 1, 1)
const pageSize = 10
const offset = (page - 1) * pageSize

const [posts, profile] = await Promise.all([
  getPostsPage({ limit: pageSize + 1, offset }),
  getProfile(),
])

const hasNextPage = posts.length > pageSize
const visiblePosts = hasNextPage ? posts.slice(0, pageSize) : posts
const postModels = await buildEntryCardModels(visiblePosts, { excerptLength: 100 })

const prevPageUrl = page > 1 ? (page === 2 ? '/stream' : `/stream?page=${page - 1}`) : null
const nextPageUrl = hasNextPage ? `/stream?page=${page + 1}` : null

applyPageCacheHeaders(Astro.response, 'stream')
---

<BaseLayout title="貼文 | Double River" description="收納當下的片段、短記和最近更新。">
  <div class="stream-container">
    <header class="stream-header">
      <h1>貼文</h1>
      <p>最近的短記、想法、圖片和小更新。</p>
    </header>

    <div class="posts-list">
      {
        postModels.length > 0 ? (
          postModels.map((item) => (
            <div class="post-item">
              <PostFeedCard
                href={item.href}
                title={item.displayTitle}
                excerpt={item.displayExcerpt}
                date={item.displayDate}
                displayName={profile.name}
                avatarUrl={profile.avatar_url}
                coverUrl={item.coverUrl}
                coverAlt={item.coverAlt}
                stats={item.metrics}
              />
            </div>
          ))
        ) : (
          <p class="empty-state">還沒有任何貼文</p>
        )
      }
    </div>

    {(prevPageUrl || nextPageUrl) && (
      <nav class="stream-pagination" aria-label="貼文分頁">
        {prevPageUrl ? (
          <a href={prevPageUrl} class="page-link">← 較新的貼文</a>
        ) : (
          <span class="page-link page-link-disabled">← 較新的貼文</span>
        )}

        <span class="page-status">第 {page} 頁</span>

        {nextPageUrl ? (
          <a href={nextPageUrl} class="page-link">較舊的貼文 →</a>
        ) : (
          <span class="page-link page-link-disabled">較舊的貼文 →</span>
        )}
      </nav>
    )}
  </div>
</BaseLayout>

<style>
  .stream-container {
    max-width: 720px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    overflow-x: hidden;
  }

  .stream-header {
    margin-bottom: 2.5rem;
  }

  .stream-header h1 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 0.3rem;
  }

  .stream-header p {
    color: #888;
    font-size: 0.95rem;
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    background: var(--surface, #fff);
    border: 1px solid var(--border, #dddaf0);
    border-radius: 14px;
    overflow: hidden;
  }

  .empty-state {
    text-align: center;
    color: #999;
    padding: 3rem;
  }

  .post-item {
    display: block;
  }

  .stream-pagination {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .page-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 8.5rem;
    padding: 0.7rem 1rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--accent);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }

  .page-link-disabled {
    color: var(--text-muted);
    opacity: 0.55;
  }

  .page-status {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  @media (max-width: 640px) {
    .stream-container {
      padding: 1.25rem 1rem;
    }

    .stream-header h1 {
      font-size: 1.3rem;
    }

    .stream-pagination {
      flex-direction: column;
    }

    .page-link,
    .page-link-disabled {
      width: 100%;
    }
  }
</style>
