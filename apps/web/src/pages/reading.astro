---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getReadingEntriesPage } from '../lib/data';
import {
  GENRE_LABELS,
  MEDIUM_LABELS,
  READ_STATUS_LABELS,
  WORK_STATUS_LABELS,
  formatScore,
  formatReadAt,
  type SortKey,
} from '../lib/reading';

const searchParams = Astro.url.searchParams;
const q = searchParams.get('q')?.trim() || '';
const genre = searchParams.get('genre')?.trim() || '';
const medium = searchParams.get('medium')?.trim() || '';
const status = searchParams.get('status')?.trim() || '';
const rawSort = searchParams.get('sort')?.trim() || 'readAt';
const sort: SortKey = rawSort === 'score' || rawSort === 'title' || rawSort === 'readAt' ? rawSort : 'readAt';
const page = Math.max(Number.parseInt(searchParams.get('page') || '1', 10) || 1, 1);
const pageSize = 30;
const offset = (page - 1) * pageSize;

const {
  data: pageItems,
  total: filteredTotal,
  ok: readingPageOk,
  error: readingPageError,
} = await getReadingEntriesPage({
  q: q || undefined,
  genre: genre || undefined,
  medium: medium || undefined,
  read_status: status || undefined,
  sort: sort === 'readAt' ? 'read_at' : sort,
  limit: pageSize,
  offset,
});

const {
  total: totalCount,
  ok: totalCountOk,
} = await getReadingEntriesPage({ limit: 1, offset: 0 });

const {
  total: completedCount,
  ok: completedCountOk,
} = await getReadingEntriesPage({ read_status: 'completed', limit: 1, offset: 0 });

const {
  total: ongoingCount,
  ok: ongoingCountOk,
} = await getReadingEntriesPage({ read_status: 'ongoing', limit: 1, offset: 0 });

const statsOk = totalCountOk && completedCountOk && ongoingCountOk;

const totalPages = Math.max(Math.ceil(filteredTotal / pageSize), 1);
const safePage = Math.min(page, totalPages);
const pageStart = filteredTotal === 0 ? 0 : (safePage - 1) * pageSize + 1;
const pageEnd = filteredTotal === 0 ? 0 : Math.min((safePage - 1) * pageSize + pageItems.length, filteredTotal);

const scored = pageItems.filter((entry) => entry.score != null);
const avgScore =
  scored.length > 0
    ? (scored.reduce((sum, entry) => sum + (entry.score ?? 0), 0) / scored.length).toFixed(1)
    : null;

function buildReadingUrl(next: {
  q?: string;
  genre?: string;
  medium?: string;
  status?: string;
  sort?: SortKey;
  page?: number;
}) {
  const params = new URLSearchParams();

  if (next.q) params.set('q', next.q);
  if (next.genre) params.set('genre', next.genre);
  if (next.medium) params.set('medium', next.medium);
  if (next.status) params.set('status', next.status);
  if (next.sort && next.sort !== 'readAt') params.set('sort', next.sort);
  if (next.page && next.page > 1) params.set('page', String(next.page));

  const query = params.toString();
  return query ? `/reading?${query}` : '/reading';
}

const hasFilters = Boolean(q || genre || medium || status || sort !== 'readAt');
const prevPageUrl = safePage > 1
  ? buildReadingUrl({ q, genre, medium, status, sort, page: safePage - 1 })
  : null;
const nextPageUrl = safePage < totalPages
  ? buildReadingUrl({ q, genre, medium, status, sort, page: safePage + 1 })
  : null;
const resetUrl = '/reading';
---

<BaseLayout title="閱讀 | Double River" description="記下讀過的作品，不是完整書評，是帶情緒的閱讀地圖。">
  <div class="reading-shell">
    <header class="reading-header">
      <p class="reading-kicker">reading archive</p>
      <h1>閱讀</h1>
      <p class="reading-desc">記下讀過、喜歡過、卡住過的作品。不是完整書評，更像帶情緒的閱讀地圖。</p>
    </header>

    <div class="reading-stats">
      <div class="stat-item">
        <span class="stat-num">{statsOk ? totalCount : '—'}</span>
        <span class="stat-label">已記錄</span>
      </div>
      <div class="stat-item">
        <span class="stat-num">{statsOk ? completedCount : '—'}</span>
        <span class="stat-label">讀完</span>
      </div>
      <div class="stat-item">
        <span class="stat-num">{statsOk ? ongoingCount : '—'}</span>
        <span class="stat-label">追更中</span>
      </div>
      {avgScore && (
        <div class="stat-item">
          <span class="stat-num">{avgScore}</span>
          <span class="stat-label">本頁平均評分</span>
        </div>
      )}
    </div>

    <form method="GET" class="reading-toolbar">
      <div class="toolbar-search">
        <input
          id="readingSearch"
          name="q"
          type="search"
          placeholder="搜尋書名、作者、短評…"
          autocomplete="off"
          value={q}
          aria-label="搜尋閱讀清單"
        />
      </div>
      <div class="toolbar-filters">
        <select id="filterGenre" name="genre" aria-label="篩選分類">
          <option value="" selected={genre === ''}>全部分類</option>
          <option value="bl" selected={genre === 'bl'}>BL</option>
          <option value="bg" selected={genre === 'bg'}>BG</option>
          <option value="gl" selected={genre === 'gl'}>GL</option>
          <option value="gen" selected={genre === 'gen'}>無CP</option>
        </select>
        <select id="filterMedium" name="medium" aria-label="篩選媒介">
          <option value="" selected={medium === ''}>全部媒介</option>
          <option value="novel" selected={medium === 'novel'}>小說</option>
          <option value="comic" selected={medium === 'comic'}>漫畫</option>
          <option value="manhwa" selected={medium === 'manhwa'}>韓漫</option>
          <option value="manga" selected={medium === 'manga'}>日漫</option>
          <option value="webtoon" selected={medium === 'webtoon'}>條漫</option>
          <option value="drama" selected={medium === 'drama'}>韓劇</option>
        </select>
        <select id="filterStatus" name="status" aria-label="篩選閱讀狀態">
          <option value="" selected={status === ''}>全部狀態</option>
          <option value="completed" selected={status === 'completed'}>讀完</option>
          <option value="ongoing" selected={status === 'ongoing'}>追更中</option>
          <option value="dropped" selected={status === 'dropped'}>棄文</option>
        </select>
        <select id="sortBy" name="sort" aria-label="排序方式">
          <option value="readAt" selected={sort === 'readAt'}>最近閱讀</option>
          <option value="score" selected={sort === 'score'}>評分高低</option>
          <option value="title" selected={sort === 'title'}>書名</option>
        </select>
        <button type="submit" class="toolbar-submit">套用</button>
        {hasFilters && (
          <a href={resetUrl} class="toolbar-reset">清除</a>
        )}
      </div>
    </form>

    {readingPageOk && (
      <div class="reading-count" aria-live="polite">
        {filteredTotal === totalCount ? `共 ${totalCount} 筆` : `共 ${filteredTotal} 筆，顯示 ${pageStart}-${pageEnd}`}
      </div>
    )}

    {!readingPageOk ? (
      <div class="reading-state-card reading-state-error" role="alert">
        <h2>暫時讀不到閱讀清單</h2>
        <p>{readingPageError || '目前資料載入失敗，請稍後再試一次。'}</p>
        <div class="reading-state-actions">
          <a href={resetUrl} class="toolbar-reset">重新整理</a>
        </div>
      </div>
    ) : pageItems.length === 0 ? (
      <p class="reading-empty">
        {hasFilters ? (
          <>
            這個條件目前沒有結果。你可以調整篩選，或先清除條件再看看。
            <span class="reading-empty-actions">
              <a href={resetUrl}>看全部閱讀</a>
            </span>
          </>
        ) : (
          <>閱讀清單還是空的，先去 Discord 用 <code>/讀了</code> 記一本。</>
        )}
      </p>
    ) : (
      <>
        <div class="reading-table-wrap">
          <table class="reading-table" id="readingTable">
            <thead>
              <tr>
                <th class="col-title">書名</th>
                <th class="col-author">作者</th>
                <th class="col-genre">分類</th>
                <th class="col-medium">媒介</th>
                <th class="col-status">狀態</th>
                <th class="col-score">評分</th>
                <th class="col-date">閱讀日期</th>
                <th class="col-review">短評</th>
              </tr>
            </thead>
            <tbody>
              {pageItems.map((item) => (
                <tr>
                  <td class="col-title">
                    {item.has_detail === 1 ? (
                      <a href={`/reading/${item.slug}`} class="entry-title-link">{item.title}</a>
                    ) : (
                      <span class="entry-title-text">{item.title}</span>
                    )}
                  </td>
                  <td class="col-author">{item.author ?? '—'}</td>
                  <td class="col-genre">
                    <span class={`badge badge-genre badge-genre-${item.genre}`}>
                      {GENRE_LABELS[item.genre] ?? item.genre}
                    </span>
                  </td>
                  <td class="col-medium">
                    <span class="badge badge-medium">{MEDIUM_LABELS[item.medium] ?? item.medium}</span>
                  </td>
                  <td class="col-status">
                    <span class={`badge badge-status badge-status-${item.read_status}`}>
                      {READ_STATUS_LABELS[item.read_status] ?? item.read_status}
                    </span>
                    {item.work_status !== 'unknown' && (
                      <span class="badge badge-work-status">
                        {WORK_STATUS_LABELS[item.work_status]}
                      </span>
                    )}
                  </td>
                  <td class="col-score">
                    <span class={`score-val ${item.score != null ? (item.score >= 9 ? 'score-high' : item.score >= 7 ? 'score-mid' : 'score-low') : 'score-none'}`}>
                      {formatScore(item.score ?? undefined)}
                    </span>
                  </td>
                  <td class="col-date">{formatReadAt(item.read_at ?? undefined)}</td>
                  <td class="col-review">{item.short_review ?? ''}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        {totalPages > 1 && (
          <nav class="reading-pagination" aria-label="閱讀列表分頁">
            {prevPageUrl ? (
              <a href={prevPageUrl} class="page-link">← 上一頁</a>
            ) : (
              <span class="page-link page-link-disabled">← 上一頁</span>
            )}
            <span class="page-status">第 {safePage} / {totalPages} 頁</span>
            {nextPageUrl ? (
              <a href={nextPageUrl} class="page-link">下一頁 →</a>
            ) : (
              <span class="page-link page-link-disabled">下一頁 →</span>
            )}
          </nav>
        )}
      </>
    )}
  </div>
</BaseLayout>

<style>
  .reading-shell {
    max-width: 1280px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  .reading-header {
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }

  .reading-kicker {
    margin: 0 0 0.5rem;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.8rem;
  }

  .reading-header h1 {
    margin: 0;
    font-size: clamp(2.2rem, 6vw, 4.5rem);
    line-height: 1;
  }

  .reading-desc {
    margin: 0.9rem 0 0;
    max-width: 48rem;
    color: var(--text-soft);
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .reading-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-bottom: 1.4rem;
  }

  .stat-item {
    min-width: 8rem;
    padding: 0.95rem 1rem;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.72);
  }

  .stat-num {
    display: block;
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--accent);
  }

  .stat-label {
    color: var(--text-soft);
    font-size: 0.88rem;
  }

  .reading-toolbar {
    display: grid;
    gap: 0.9rem;
    margin-bottom: 0.9rem;
  }

  .toolbar-search input {
    width: 100%;
    padding: 0.9rem 1rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.84);
    font: inherit;
  }

  .toolbar-filters {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .toolbar-filters select,
  .toolbar-submit,
  .toolbar-reset {
    padding: 0.78rem 0.95rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.84);
    font: inherit;
  }

  .toolbar-submit {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent);
    cursor: pointer;
  }

  .toolbar-reset {
    color: var(--text);
    text-decoration: none;
  }

  .reading-count {
    margin: 0.25rem 0 1rem;
    color: var(--text-soft);
    font-size: 0.92rem;
  }

  .reading-table-wrap {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 1.4rem;
    background: rgba(255, 255, 255, 0.88);
  }

  .reading-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 980px;
  }

  .reading-table th,
  .reading-table td {
    padding: 1.1rem 1rem;
    border-bottom: 1px solid rgba(92, 87, 132, 0.12);
    vertical-align: top;
    text-align: left;
  }

  .reading-table thead th {
    font-size: 0.92rem;
    color: var(--text-soft);
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .reading-table tbody tr:last-child td {
    border-bottom: none;
  }

  .entry-title-link,
  .entry-title-text {
    font-weight: 700;
    font-size: 1rem;
  }

  .entry-title-link {
    color: var(--text);
    text-decoration: none;
  }

  .entry-title-link:hover {
    color: var(--accent);
  }

  .badge {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: 0.3rem 0.7rem;
    font-size: 0.82rem;
    line-height: 1;
    border: 1px solid rgba(92, 87, 132, 0.16);
    white-space: nowrap;
    background: #fff;
  }

  .badge + .badge {
    margin-left: 0.35rem;
  }

  .badge-genre { color: #5f55b1; background: #f0edff; }
  .badge-medium { color: #5b538a; background: #f6f3ff; }
  .badge-status-completed { color: #1f7a55; background: #e7fbf1; }
  .badge-status-ongoing { color: #8d5a10; background: #fff5dd; }
  .badge-status-dropped { color: #8e4650; background: #ffecef; }
  .badge-work-status { color: #665d8b; background: #f3efff; }

  .score-val { font-weight: 700; }
  .score-high { color: #257a4e; }
  .score-mid { color: #4c63c7; }
  .score-low { color: #877f99; }
  .score-none { color: #aaa4b7; }

  .col-review {
    max-width: 30rem;
    color: var(--text-soft);
    line-height: 1.75;
  }

  .reading-empty {
    padding: 1.4rem 1.2rem;
    border: 1px dashed var(--border);
    border-radius: 1rem;
    color: var(--text-soft);
    background: rgba(255, 255, 255, 0.65);
  }

  .reading-empty-actions {
    display: inline-block;
    margin-left: 0.4rem;
  }

  .reading-empty a {
    color: var(--accent);
  }

  .reading-state-card {
    padding: 1.3rem 1.2rem;
    border-radius: 1rem;
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.84);
  }

  .reading-state-card h2 {
    margin: 0 0 0.4rem;
    font-size: 1.05rem;
  }

  .reading-state-card p {
    margin: 0;
    color: var(--text-soft);
    line-height: 1.75;
  }

  .reading-state-error {
    border-color: rgba(180, 71, 71, 0.22);
    background: rgba(255, 245, 245, 0.9);
  }

  .reading-state-actions {
    margin-top: 0.9rem;
  }

  .reading-pagination {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 1rem;
  }

  .page-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 7rem;
    padding: 0.72rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.84);
    color: var(--text);
    text-decoration: none;
  }

  .page-link-disabled {
    color: var(--text-soft);
    opacity: 0.55;
  }

  .page-status {
    color: var(--text-soft);
    font-size: 0.92rem;
  }

  @media (max-width: 720px) {
    .reading-shell {
      padding: 1.4rem 1rem 3rem;
    }

    .reading-pagination {
      flex-direction: column;
    }

    .page-link,
    .page-link-disabled {
      width: 100%;
    }
  }
</style>
